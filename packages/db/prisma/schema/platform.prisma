model OjProfile {
  id            Int             @id @default(autoincrement())
  handle        String
  userId        Int
  platform      Platform
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified      Boolean         @default(false)
  ratingHistory RatingHistory[]
  rating        Int             @default(0)
  maxRating     Int             @default(0)
  totalSolved   Int             @default(0)
  totalContests Int             @default(0)
  easySolved    Int             @default(0)
  mediumSolved  Int             @default(0)
  hardSolved    Int             @default(0)
  rank          Int             @default(0)
  maxRank       Int             @default(0)
  badge         String?
  submissions   Submission[]
  createdAt     DateTime        @default(now())
  lastUpdated   DateTime        @updatedAt

  @@unique([userId, platform])
  @@unique([handle, platform])
}

model LeetcodeSubmissionHistory {
  id           String   @id @default(uuid())
  problemTitle String
  url          String
  submissionId String   @unique
  submittedAt  DateTime @default(now())
}

model RatingHistory {
  ojProfileId  Int
  ojProfile    OjProfile @relation(fields: [ojProfileId], references: [id], onDelete: Cascade)
  platform     Platform  @default(CODEFORCES)
  contestTitle String
  rating       Int
  rank         Int
  date         Int
  delta        Int       @default(0)

  @@id([ojProfileId, platform, date])
}

model Submission {
  id          Int       @id @default(autoincrement())
  platform    Platform
  submittedOn DateTime
  count       Int       @default(1)
  ojProfileId Int
  ojProfile   OjProfile @relation(fields: [ojProfileId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([ojProfileId, submittedOn])
}
